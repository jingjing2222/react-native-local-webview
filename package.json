{
  "name": "react-native-local-webview-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "changeset": "changeset",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build && yarn publint",
    "clean": "nx reset && del-cli examples/showcase/android/build examples/showcase/android/app/build examples/showcase/ios/build packages/react-native-local-webview/dist",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "graph": "nx graph",
    "lint": "nx run-many -t lint",
    "publint": "nx run-many -t publint",
    "release": "yarn build && changeset publish",
    "showcase": "yarn workspace react-native-local-webview-example",
    "test": "nx run-many -t test",
    "test:coverage": "nx run react-native-local-webview:test:coverage",
    "typecheck": "nx run-many -t typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@vitest/coverage-v8": "4.1.10",
    "del-cli": "^7.0.0",
    "nx": "23.1.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "yarn@4.11.0"
}
