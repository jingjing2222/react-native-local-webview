{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "requireBranch": "main",
    "tagName": "v${version}"
  },
  "github": {
    "autoGenerate": true,
    "release": true
  },
  "hooks": {
    "before:init": "yarn check"
  },
  "npm": {
    "publish": true,
    "skipChecks": true
  }
}
