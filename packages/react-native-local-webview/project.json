{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "react-native-local-webview",
  "projectType": "library",
  "root": "packages/react-native-local-webview",
  "sourceRoot": "packages/react-native-local-webview/src",
  "tags": ["scope:library", "type:publishable"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "yarn workspace react-native-local-webview build"
      }
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "test", "build", "publint"],
      "executor": "nx:noop"
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn oxlint --type-aware --deny-warnings --react-plugin --import-plugin --promise-plugin --vitest-plugin packages/react-native-local-webview"
      }
    },
    "publint": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn workspace react-native-local-webview publint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn vitest run --config packages/react-native-local-webview/vitest.config.ts"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage"],
      "options": {
        "command": "yarn vitest run --coverage --config packages/react-native-local-webview/vitest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn workspace react-native-local-webview typecheck"
      }
    }
  }
}
