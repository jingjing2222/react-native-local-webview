{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".yarn/**",
    "examples/showcase/android/**",
    "examples/showcase/ios/**",
    "dist/**",
    "packages/react-native-local-webview/nitrogen/**",
    "node_modules/**",
    "yarn.lock"
  ],
  "printWidth": 100,
  "quoteProps": "consistent",
  "singleQuote": true,
  "trailingComma": "es5"
}
